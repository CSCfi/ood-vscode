---
form_header: |
  <a href="https://docs.csc.fi/computing/webinterface/vscode/" target="_blank">Documentation</a>
attributes:
  csc_slurm_partition:
    value: interactive
    select:
      - "interactive"
      - "small"
      - "test"
      - "fmi"
      - "fmitest"
  csc_memory:
    value: 2
  code_version:
    widget: select
    options:
      - 1.96.4
      - 1.89.1
      - 1.86.1
      - 1.80.2
      - 1.76.1
      - ["1.70.2 ( old version )", "1.70.2" ]
    value: 1.96.4
  compiler:
      widget: select
      options:
          - "intel-oneapi-compilers/2022.1.0"
          - "gcc/11.3.0"
  modules:
      help: | 
          Space separated list of modules to load, e.g
          openmpi geoconda
  csc_reset_cache:
    app: "sys/ood-vscode"

form:
  - csc_slurm_reservation
  - csc_slurm_project
  - csc_slurm_partition
  - csc_header_resources
  - csc_cores
  - csc_memory
  - csc_nvme
  - csc_time
  - csc_header_settings
  - code_version
  - compiler 
  - modules
  - bc_email_on_started
  - csc_reset_cache
  - csc_slurm_limits
