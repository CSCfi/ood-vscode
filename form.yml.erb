---
form_header: |
  <a href="https://docs.lumi-supercomputer.eu/runjobs/webui/vscode/" target="_blank">Documentation</a>
attributes:
  csc_slurm_partition:
    value: interactive
    select:
      - "interactive"
      - "small"
      - "small-g"
      - "largemem"
      - "lumid"
      - "dev-g"
      - "debug"
      - "q_industry"
  csc_memory:
    value: 2
  code_version:
    widget: select
    options:
      - 1.92.2
      - 1.89.1
      - 1.83.1
    value: 1.92.2
  compiler:
      widget: select
      options:
        - "PrgEnv-cray"
        - "PrgEnv-amd"
        - "PrgEnv-gnu"
        - "PrgEnv-aocc"
  modules:
      help: | 
          Space separated list of modules to load, e.g
          cray-hdf5 cray-netcdf
  csc_reset_cache:
    app: "sys/ood-vscode"

form:
  - csc_slurm_reservation
  - csc_slurm_project
  - csc_slurm_partition
  - csc_header_resources
  - csc_cores
  - csc_memory
  - csc_nvme
  - csc_gpu
  - csc_time
  - csc_header_settings
  - code_version
  - compiler
  - modules
  - csc_reset_cache
  - csc_slurm_limits
