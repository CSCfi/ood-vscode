#!/usr/bin/env bash

# Benchmark info
echo "TIMING - Starting main script at: $(date)"

# Set working directory to home directory
cd "${HOME}"

#
# Start Jupyter Notebook Server
#
module purge
module load git
module load <%= context.compiler %>
module load openmpi

<%- if context.python_module != "none" %>
  echo "Loading <%= context.full_python_module %> as python module"
  module load "<%= context.full_python_module %>"
<% end %>

<%- unless context.modules.blank? -%>
# Purge the module environment to avoid conflicts
#module purge

# Load the require modules
module load <%= context.modules %>

# List loaded modules
<%- end -%>

export _CXX_PATH=$(which $CXX)
if [[ "$CXX" == "icpc"  ]];then
  export _EXTRA_INCLUDES=$(readlink -f $(dirname $_CXX_PATH)/../../compiler/include)
  export CPATH="$CPATH:/appl/spack/install-tree/gcc-4.8.5/gcc-8.3.0-qzmzn5/include/c++/8.3.0/x86_64-pc-linux-gnu/"
fi
module list

# Benchmark info
echo "TIMING - Starting Visual Studio Code at: $(date)"

# Launch the VS code Server
export _PYTHON_EXE=$(which python3)
VSCODE_USER_CONFIG="$HOME/.local/share/csc-vscode/User/settings.json"
if [[ ! -f "$VSCODE_USER_CONFIG" || ! -s "$VSCODE_USER_CONFIG" ]];then
  mkdir -p "$(basename "$VSCODE_USER_CONFIG")"
    echo '
{
    "workbench.editorAssociations": [
        {
            "viewType": "jupyter.notebook.ipynb",
            "filenamePattern": "*.ipynb"
        }
    ],
    "python.pythonPath": "${env:_PYTHON_EXE}",
    "python.defaultInterpreterPath": "${env:_PYTHON_EXE}",
    "python.linting.enabled": true,
    "workbench.colorTheme": "Quiet Light",
    "extensions.autoUpdate": false,
    "extensions.autoCheckUpdates": false,
    "C_Cpp.default.includePath": ["${env:CPATH}", "${env:_EXTRA_INCLUDES}"],
    "C_Cpp.default.compilerPath": "${env:_CXX_PATH}"
}
' > "$VSCODE_USER_CONFIG"
# setting compiler path to icpc breaks some parts
# "C_Cpp.default.compilerPath": "${env:_CXX_PATH}"
else
  /usr/bin/jq '."python.pythonPath" = "${env:_PYTHON_EXE}" | ."python.defaultInterpreterPath" = "${env:_PYTHON_EXE}"' "$VSCODE_USER_CONFIG" > "$VSCODE_USER_CONFIG.tmp" && mv "$VSCODE_USER_CONFIG.tmp" "$VSCODE_USER_CONFIG"
fi
VSCODE_MACHINE_CONFIG="$HOME/.local/share/csc-vscode/Machine/settings.json"
if [[ ! -f "$VSCODE_MACHINE_CONFIG" || ! -s "$VSCODE_MACHINE_CONFIG" ]];then
  mkdir -p "$(basename "$VSCODE_MACHINE_CONFIG")"
    echo '
{
    "python.defaultInterpreterPath": "${env:_PYTHON_EXE}"
}
' > "$VSCODE_MACHINE_CONFIG"
else
  /usr/bin/jq '."python.defaultInterpreterPath" = "${env:_PYTHON_EXE}"' "$VSCODE_MACHINE_CONFIG" > "$VSCODE_MACHINE_CONFIG.tmp" && mv "$VSCODE_MACHINE_CONFIG.tmp" "$VSCODE_MACHINE_CONFIG"
fi


export SING_FLAGS="$SING_FLAGS -B /appl/opt/ood/$SLURM_OOD_ENV:/appl/opt/ood/$SLURM_OOD_ENV"

PY_INT_REF=$(dirname $(python -c 'import sys;print(sys.executable)'))
PY_EXT_REF=$(dirname $(which python ))
if [[ ! $PY_INT_REF == $PY_EXT_REF  ]];then
    mkdir -p $TMPDIR/.oodvscode_hack 
    ln -fs $PY_INT_REF/python $TMPDIR/.oodvscode_hack/python 
    ln -fs $PY_INT_REF/python3 $TMPDIR/.oodvscode_hack/python3
    export SINGULARITY_BIND="$TMPDIR/.oodvscode_hack/:$PY_EXT_REF"
fi

export CODE_EXE=/appl/opt/ood/$SLURM_OOD_ENV/soft/vscode-code-server/<%= context.code_version %>/bin/code-server

echo "USING CODE-SERVER: $CODE_EXE"
set -x
$CODE_EXE --extensions-dir="$HOME/.local/share/csc-vscode/extensions" --disable-telemetry --user-data-dir="$HOME/.local/share/csc-vscode" --disable-update-check --config "${CONFIG_FILE}" --ignore-last-opened
